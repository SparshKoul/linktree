PORT=3001
NODE_ENV=development

# Supabase (required - the whole app reads and writes through these)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Secret used to sign the session cookie. Use a long random string.
# If missing, the Supabase service role key is used instead.
SESSION_SECRET=change-me-to-a-long-random-string

# Extra origins allowed to call the API with credentials (comma separated).
# The site itself is same-origin, so this is only needed for separate domains.
ALLOWED_ORIGINS=http://localhost:5173

# Password for the seeded super admin account (first run only)
ADMIN_INITIAL_PASSWORD=your_secure_password_here

# Secret for the work the site does by itself. The scheduler of Vercel
# sends it with every request, so the route that cleans the table of the
# events only listens to the scheduler.
CRON_SECRET=change-me-to-another-long-random-string

# How many days of the events are kept. The old ones are taken away every
# night, so the numbers on the screen stay quick to work out.
ANALYTICS_RETENTION_DAYS=180
